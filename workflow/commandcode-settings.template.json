{
  "_comment": "Command Code permission template - installed by tools/setup.ps1.\n\nRules only. The audio (Claudio) hooks are deliberately NOT here: audio\nfeedback is an optional personal add-on, and a hook that points at a\nmissing binary is a hook that fails on every event.\n\ndeny  = destructive git, in plain / rtk / rtk-proxy form.\nask   = VCS history and remote operations, plus system/admin operations.\nallow = the shell tools that run unattended.\n\n__WORKSPACE__ is replaced with the install directory at setup time.",
  "permissions": {
    "allow": [
      "Shell(where:*)",
      "Shell(npm:*)",
      "Shell(command-code:*)",
      "Shell(cmdc:*)",
      "Shell(rtk:*)",
      "powershell",
      "Shell(dir:*)",
      "Shell(cargo:*)",
      "Shell(findstr:*)",
      "Shell(pip:*)",
      "Shell(choco:*)",
      "Shell(winget:*)",
      "Shell(scoop:*)",
      "Shell(pnpm:*)",
      "Shell(yarn:*)",
      "Shell(set:*)",
      "Shell(type:*)",
      "Shell(codex:*)",
      "Shell(opencode:*)",
      "Shell(freebuff:*)",
      "Shell(for:*)",
      "Shell(@where:*)",
      "Shell(mkdir:*)",
      "Shell(tar:*)",
      "Shell(copy:*)",
      "Shell(more:*)",
      "Shell(corepack:*)",
      "Shell(rustup:*)",
      "Shell(rustc:*)",
      "Shell(bun:*)",
      "Shell(dotnet:*)",
      "Shell(top:*)",
      "Shell(pipx:*)"
    ],
    "ask": [
      "Shell(git push:*)",
      "Shell(rtk git push:*)",
      "Shell(rtk proxy git push:*)",
      "Shell(git merge:*)",
      "Shell(rtk git merge:*)",
      "Shell(rtk proxy git merge:*)",
      "Shell(git rebase:*)",
      "Shell(rtk git rebase:*)",
      "Shell(rtk proxy git rebase:*)",
      "Shell(git branch -D:*)",
      "Shell(rtk git branch -D:*)",
      "Shell(rtk proxy git branch -D:*)",
      "Shell(git remote add:*)",
      "Shell(rtk git remote add:*)",
      "Shell(rtk proxy git remote add:*)",
      "Shell(git remote remove:*)",
      "Shell(rtk git remote remove:*)",
      "Shell(rtk proxy git remote remove:*)",
      "Shell(git remote set-url:*)",
      "Shell(rtk git remote set-url:*)",
      "Shell(rtk proxy git remote set-url:*)",
      "Shell(gh pr create:*)",
      "Shell(winget *--scope machine*)",
      "Shell(choco install:*)",
      "Shell(choco upgrade:*)",
      "Shell(setx:*)",
      "Shell(reg add:*)",
      "Shell(reg delete:*)",
      "Shell(netsh:*)",
      "Shell(bcdedit:*)",
      "Shell(sc config:*)",
      "Shell(dism:*)",
      "Shell(Set-ExecutionPolicy:*)"
    ],
    "deny": [
      "Shell(git push --force*)",
      "Shell(git reset --hard*)",
      "Shell(git clean -*)",
      "Shell(rtk git push --force*)",
      "Shell(rtk git reset --hard*)",
      "Shell(rtk git clean -*)",
      "Shell(rtk proxy git push --force*)",
      "Shell(rtk proxy git reset --hard*)",
      "Shell(rtk proxy git clean -*)"
    ],
    "additionalDirectories": [
      "__WORKSPACE__"
    ],
    "defaultMode": "yolo"
  }
}
